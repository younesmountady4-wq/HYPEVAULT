<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>HYPEVAULT</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
background:#111;
color:white;
overflow-x:hidden;
}

/* NAVBAR */

header{
position:fixed;
top:0;
width:100%;
padding:20px 60px;
display:flex;
justify-content:space-between;
align-items:center;
background:rgba(0,0,0,0.8);
backdrop-filter:blur(10px);
z-index:1000;
}

.logo{
font-size:28px;
font-weight:900;
letter-spacing:4px;

background:linear-gradient(
45deg,
#ffffff,
#d8d8d8,
#ffffff,
#bdbdbd,
#ffffff
);

-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

nav a{
color:white;
text-decoration:none;
margin-left:25px;
font-weight:bold;
}

nav a:hover{
color:#00ff88;
}

/* HERO */

.hero{
height:100vh;

background:
linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.75)),
linear-gradient(135deg,#7b7b7b,#494949,#1d1d1d);

display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

/* CASSAFORTE */

.vault{
width:320px;
height:320px;
border-radius:50%;

background:
radial-gradient(circle,
#a9a9a9,
#6f6f6f,
#2d2d2d);

border:10px solid #d6d6d6;

position:relative;

box-shadow:
0 0 40px rgba(255,255,255,0.25),
inset 0 0 50px rgba(0,0,0,.7);

animation:pulse 4s infinite;
}

.wheel{
position:absolute;
top:50%;
left:50%;
transform:translate(-50%,-50%);
width:120px;
height:120px;
border-radius:50%;
border:6px solid white;
animation:spin 8s linear infinite;
}

.wheel::before{
content:"";
position:absolute;
left:50%;
top:10px;
width:8px;
height:90px;
background:white;
transform:translateX(-50%);
}

.wheel::after{
content:"";
position:absolute;
top:50%;
left:10px;
width:90px;
height:8px;
background:white;
transform:translateY(-50%);
}

.title{
margin-top:40px;
font-size:80px;
font-weight:900;
letter-spacing:6px;

background:linear-gradient(
45deg,
#ffffff,
#d9d9d9,
#ffffff
);

-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

.subtitle{
margin-top:15px;
font-size:20px;
letter-spacing:4px;
color:#f0f0f0;
}

.btn{
display:inline-block;
margin-top:40px;
padding:18px 40px;
background:#00ff88;
color:black;
text-decoration:none;
font-weight:bold;
border-radius:40px;
transition:.3s;
}

.btn:hover{
transform:scale(1.08);
}

/* PRODUCTS */

.products{
padding:100px 10%;
background:#0b0b0b;
}

.products h2{
font-size:50px;
margin-bottom:50px;
color:#00ff88;
text-align:center;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
}

.card{
background:#171717;
border-radius:20px;
overflow:hidden;
transition:.4s;
}

.card:hover{
transform:translateY(-10px);
box-shadow:0 0 30px #00ff88;
}

.card img{
width:100%;
height:250px;
object-fit:cover;
}

.card-content{
padding:20px;
}

.price{
color:#00ff88;
font-size:22px;
font-weight:bold;
margin-top:10px;
}

/* FOOTER */

footer{
padding:40px;
background:black;
text-align:center;
}

@keyframes spin{
100%{
transform:translate(-50%,-50%) rotate(360deg);
}
}

@keyframes pulse{

0%{
transform:scale(1);
}

50%{
transform:scale(1.04);
}

100%{
transform:scale(1);
}

}

</style>
</head>
<body>

<header>
<div class="logo">HYPEVAULT</div>

<nav>
<a href="#">Home</a>
<a href="#">Drops</a>
<a href="#">Vault</a>
<a href="#">Archive</a>
<a href="#">Contact</a>
</nav>
</header>

<section class="hero">

<div class="vault">
<div class="wheel"></div>
</div>

<h1 class="title">HYPEVAULT</h1>

<p class="subtitle">
ENTER THE VAULT. OWN THE HYPE.
</p>

<a href="#products" class="btn">
ENTER THE VAULT
</a>

</section>

<section class="products" id="products">

<h2>FEATURED VAULT PIECES</h2>

<div class="grid">

<div class="card">
<img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=1200">
<div class="card-content">
<h3>Jordan Retro</h3>
<p class="price">€399</p>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?w=1200">
<div class="card-content">
<h3>Nike Dunk</h3>
<p class="price">€249</p>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=1200">
<div class="card-content">
<h3>Streetwear Drop</h3>
<p class="price">€199</p>
</div>
</div>

<div class="card">
<img src="https://images.unsplash.com/photo-1523398002811-999ca8dec234?w=1200">
<div class="card-content">
<h3>Exclusive Jacket</h3>
<p class="price">€329</p>
</div>
</div>

</div>

</section>

<footer>

<h3>HYPEVAULT</h3>

<p>RARE • AUTHENTIC • VAULTED</p>

</footer>

</body>
</html>
